# Copy the values to gitignored frontend/.env.local for npm run dev.
# With Docker Compose, use the COGNITO_* variables in the root .env instead.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Host name only, without https:// or a trailing slash.
NEXT_PUBLIC_COGNITO_DOMAIN=
