# Run: cfn-guard validate --rules infra/reports.guard --data infra/reports.yml

rule private_reports_bucket {
    Resources.ReportsBucket.Properties.PublicAccessBlockConfiguration.BlockPublicAcls == true
    Resources.ReportsBucket.Properties.PublicAccessBlockConfiguration.BlockPublicPolicy == true
    Resources.ReportsBucket.Properties.PublicAccessBlockConfiguration.IgnorePublicAcls == true
    Resources.ReportsBucket.Properties.PublicAccessBlockConfiguration.RestrictPublicBuckets == true
    Resources.ReportsBucket.DeletionPolicy == 'Retain'
    Resources.ReportsBucket.UpdateReplacePolicy == 'Retain'
}

rule queue_retry_window {
    Resources.ReportQueue.Properties.VisibilityTimeout >= 360
    Resources.ReportQueue.Properties.SqsManagedSseEnabled == true
    Resources.DeadLetterQueue.Properties.SqsManagedSseEnabled == true
}

rule mailer_stays_outside_vpc {
    Resources.MailerFunction.Properties.VpcConfig !exists
}

rule builder_stays_outside_vpc {
    Resources.BuilderFunction.Properties.VpcConfig !exists
    Resources.BuilderFunction.Properties.Environment.Variables.DATABASE_SECRET_ARN exists
    Resources.BuilderFunction.Properties.Environment.Variables.DATABASE_URL !exists
}

rule dlq_alarm_notifies_operator {
    Resources.DeadLetterAlarm.Properties.AlarmActions exists
    Resources.DeadLetterAlertTopicPolicy.Properties.PolicyDocument.Statement[Sid == 'AllowReportAlarm'].Condition.ArnLike."aws:SourceArn" exists
    Resources.DeadLetterAlertTopicPolicy.Properties.PolicyDocument.Statement[Sid == 'AllowReportAlarm'].Condition.StringEquals."aws:SourceAccount" exists
}
