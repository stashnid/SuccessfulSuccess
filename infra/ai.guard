# Run: cfn-guard validate --rules infra/ai.guard --data infra/ai.yml

rule parser_has_no_database_or_vpc {
    Resources.ParserFunction.Properties.VpcConfig !exists
    Resources.ParserFunction.Properties.Environment.Variables.DATABASE_URL !exists
    Resources.ParserFunction.Properties.Environment.Variables.DATABASE_SECRET_ARN !exists
}

rule parser_bounds_cost_and_runtime {
    Resources.ParserFunction.Properties.Timeout <= 30
    Resources.ParserFunction.Properties.MemorySize <= 512
    Resources.ParserFunction.Properties.ReservedConcurrentExecutions !exists
    Resources.MonthlyBudget.Properties.Budget.BudgetLimit.Amount <= 5
}

rule parser_requires_reviewable_web_origin {
    Resources.ParserUrl.Properties.Cors.AllowOrigins[0].Ref == 'SiteOrigin'
    Resources.ParserUrl.Properties.Cors.AllowMethods[0] == 'POST'
}
